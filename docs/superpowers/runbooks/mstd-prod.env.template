# 民商通达生产实例 .env 模板（2026-07-13 生成，基线 = 测试组织应用 v1.0.4）
# 用法：cp 到生产机 mstd-orchestrator/.env → 填空 → chmod 600 → 按 agent-rollout.md §0 前置检查过一遍
# 规则：<> 尖括号 = 必须人工填；其余默认值即生产推荐值

# ============ 模型层（与测试组织共用网关，key 可复用也可另开生产 key） ============
CZ_CLAUDE_KEY=<sk-...>
CZ_GPT_KEY=<sk-...>
DEEPSEEK_KEY=<sk-...>

# ============ 飞书通道（换成民商通达正式应用与服务账号） ============
# 先在生产机建 profile：
#   lark-cli config init --profile mstd-prod --app-id <正式应用AppID> --app-secret-stdin
# 再服务账号扫码授权（scope 串见 mstd-prod-onboarding.md §4）
LARK_PROFILE=mstd-prod
MSTD_ENABLE_AGENT=1
MSTD_BOT_OPEN_ID=<ou_... 正式应用机器人 open_id（拉 bot 进群后 im chat.members 可查）>
MSTD_BOT_NAME=小达
MSTD_BOT_ALIASES=

# ============ 服务端 ============
PORT=8787                    # 若与 rsh-api-gateway 同机部署会撞 8787，改 8899
MSTD_SESSION_SECRET=<openssl rand -hex 32>
MSTD_DB_PATH=                # 默认 db/mstd.sqlite（生产机独立目录，勿与测试库混）
MSTD_MEMORY_DIR=             # 默认 ./agent-memory；生产记忆必须从空目录起（不得复制测试组织记忆，SOUL.md 除外）
MSTD_MAX_CONCURRENT_PI=2
MSTD_SESSION_TTL_DAYS=7
MSTD_CONTEXT_ENVELOPE_MODE=enforce # 必须精确为 enforce；非法值启动即拒绝
MSTD_AGENT_ARCHITECTURE_MODE=legacy # legacy|shadow|active；生产首次启动固定 legacy
MSTD_AGENT_ACTIVE_TARGETS=         # active 时必填 canonical session key，逗号分隔；空值启动拒绝
MSTD_AGENT_SHADOW_TARGETS=         # 可选定向 shadow；不产生 dispatch/task/run/Pi 或物理出站
MSTD_DISPATCH_CONTEXT_LINES=20
MSTD_DISPATCH_CONTEXT_BYTES=8192
MSTD_MAX_REASONERS_PER_SESSION=3

# ============ 飞书 OAuth（web 调试台登录；正式应用后台需配 redirect URI） ============
FEISHU_APP_ID=<cli_... 正式应用>
FEISHU_APP_SECRET=<正式应用 secret>
FEISHU_REDIRECT_URI=http://localhost:8787/api/auth/feishu/callback

# ============ 写路径四道锁（灰度第一阶段：纯只读） ============
MSTD_ENABLE_WRITE=0          # 观察一周后再置 1；写操作仍全部走确认卡
MSTD_TEST_OPEN_IDS=<ou_... 先只放运营者本人>
MSTD_TEST_CHAT_IDS=<oc_... 正式灰度群 1-2 个>
MSTD_TEST_TASK_GUIDS=
MSTD_TEST_DOC_TOKENS=        # 允许更新的文档 token 精确白名单；空=拒绝全部文档写
MSTD_MEETING_TASK_NOTIFICATION_MODE=card

# ============ 主动层 / 预算 ============
MSTD_DAILY_TOKEN_BUDGET=2000000
MSTD_SESSION_TOKEN_BUDGET=300000
MSTD_DREAMING_MODE=shadow    # 连续 14 天影子报告审查通过前不得切 apply
MSTD_ADMIN_OPEN_IDS=<ou_... 民商通达管理员>
MSTD_ALERT_OPEN_ID=<ou_... 告警接收人>
MSTD_PRIVATE_DATA_OWNER_OPEN_ID=<ou_... 服务账号本人 open_id；仅此人私聊可读邮件/妙记>

# ============ 妙记自动派任务（灰度稳定后再开） ============
MSTD_ENABLE_TRIGGER=0        # 稳定后 =1 并配 MSTD_MINUTES_BROADCAST_CHAT 指到项目群
MSTD_BACKFILL=0

# ============ E2E（生产恒 0，勿动） ============
MSTD_E2E=0
