{
  "name": "mstd-orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pi-based autonomous management system for MSTD (local validation)",
  "bin": {
    "mstd": "bin/mstd"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "policy:eval": "node scripts/policy-eval.mjs",
    "start": "node server/index.mjs",
    "dev": "node --env-file=.env --watch server/index.mjs",
    "sim:probe": "node --env-file-if-exists=.env simulator/probe-bot-visibility.mjs",
    "sim:run": "node --env-file-if-exists=.env simulator/cli.mjs",
    "sim:e2e": "node --env-file-if-exists=.env scripts/run-simulator-e2e.mjs",
    "sim:test": "vitest run test/simulator-*.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@types/node": "^26.1.1",
    "supertest": "^7.2.2",
    "typebox": "^1.3.5",
    "vitest": "^4.0.15"
  }
}
