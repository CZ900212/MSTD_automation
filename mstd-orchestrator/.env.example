# ============ 模型层（链共用两个网关） ============
# CZ 聚合网关 (api.cz900212.com) —— 两个 provider 的 key 分离
CZ_CLAUDE_KEY=sk-...        # Claude 路由（legacy 文档保留；生产链已移出 Opus）
CZ_GPT_KEY=sk-...           # GPT-5.6 Sol（reason 链主脑，Pi 中枢，medium）
DEEPSEEK_KEY=sk-...         # DeepSeek 直连（dispatcher/fast + responder/respond 出口首选 + reason 末级备胎）
MSTD_CZ_BASE=               # 可选：覆盖 CZ 网关 base URL
MSTD_DEEPSEEK_BASE=         # 可选：覆盖 DeepSeek base URL
# 模型名覆盖（默认见 server/models/caller.mjs）
MSTD_MODEL_V4_FLASH=        # 默认 deepseek-v4-flash（non-thinking；dispatcher/fast）
MSTD_MODEL_V4_PRO=          # 默认 deepseek-v4-pro（non-thinking；responder/respond）
MSTD_MODEL_OPUS_RESPOND=    # 默认 claude-opus-4-6（legacy 文档保留）
MSTD_MODEL_OPUS_REASON=     # 默认 claude-opus-4-8（legacy 文档保留）
MSTD_MODEL_GPT=             # 默认 gpt-5.5（dispatcher/fast 兼容兜底）
MSTD_MODEL_GPT_SOL=         # 默认 gpt-5.6-sol（reason 主脑 / responder 兜底）
PI_MODEL=                   # 默认 gpt-5.6-sol
PI_THINKING=                # 默认 medium

# ============ Responder–Dispatcher–Reasoner 架构 ============
# legacy=现有 triage/fast-slow 路径（迁移默认）
# shadow=计算 responder/dispatcher 结果但不改出站/不启 task reasoner
# active=启用 responder 优先前台 + 独立 dispatcher + task-scoped reasoner
MSTD_AGENT_ARCHITECTURE_MODE=legacy
# Dispatcher 最近 transcript 窗口：按 newest-first 选取再按时间正序渲染
MSTD_DISPATCH_CONTEXT_LINES=20
MSTD_DISPATCH_CONTEXT_BYTES=8192

# ============ 飞书通道 ============
LARK_PROFILE=user613148     # 本机已授权的 lark-cli profile（持牌 user 服务账号）
MSTD_ENABLE_AGENT=0         # 1=启动常驻 agent（gateway 消费 + ticker + 三模型）
MSTD_BOT_OPEN_ID=ou_...     # 机器人自身 open_id（自回环判定；enableAgent 时必填）
MSTD_BOT_NAME=              # 机器人展示名（扁平事件无 mentions 字段，靠 @名字 文本判点名；enableAgent 时必填）
MSTD_BOT_ALIASES=           # 机器人曾用名/别名，逗号分隔（C5 改名过渡期双名命中点名；值含空格/引号时整体双引号包裹，先 zsh -n 校验）

# ============ 服务端 ============
PORT=8787
MSTD_SESSION_SECRET=        # 必填（enableWrite/enableAgent 时强制）：openssl rand -hex 32
MSTD_DB_PATH=               # 默认 db/mstd.sqlite
MSTD_MEMORY_DIR=            # 默认 ./agent-memory（五层记忆文件根目录，须 gitignore）
# （C0.3 起废除静态 MSTD_INTERNAL_TOKEN：内部通道 token 按 Pi 进程签发，不可手填）
MSTD_MAX_CONCURRENT_PI=2
MSTD_SESSION_TTL_DAYS=7
MSTD_CONTEXT_ENVELOPE_MODE=enforce # 生产固定 enforce；仅迁移诊断时显式 shadow

# ============ 飞书 OAuth（web 调试台登录；应用后台需配 redirect URI） ============
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8787/api/auth/feishu/callback

# ============ 写路径四道锁 ============
MSTD_ENABLE_WRITE=0         # 总闸：1 才真写飞书
MSTD_TEST_OPEN_IDS=         # 逗号分隔 ou_...（任务负责人/私聊通知测试白名单，fail-closed）
MSTD_TEST_CHAT_IDS=         # 逗号分隔 oc_...（send_group_msg 白名单）
MSTD_TEST_TASK_GUIDS=       # 逗号分隔飞书全局任务 GUID；仅允许完成这些可丢弃测试任务，无通配符
# 会议待办通知互斥模式：card=任务成功后发固定私聊卡（第一阶段默认）/
# feishu_system=只依赖飞书任务系统通知（零机器人私聊）/none=关闭；仅影响新 job。
MSTD_MEETING_TASK_NOTIFICATION_MODE=card

# ============ 主动层 / 预算 ============
MSTD_DAILY_TOKEN_BUDGET=2000000
MSTD_SESSION_TOKEN_BUDGET=300000
MSTD_DREAMING_MODE=shadow   # shadow=只出报告 / apply=真改记忆（灰度期用 shadow）
MSTD_ADMIN_OPEN_IDS=        # 逗号分隔 ou_...；web 调试台（/api/admin/*）管理员白名单
MSTD_ALERT_OPEN_ID=         # lark 健康检查失败时 DM 告警接收人；不授予私有数据读取权
MSTD_PRIVATE_DATA_OWNER_OPEN_ID= # 固定 LARK_PROFILE 席位的数据 owner；仅此人私聊可读邮件/妙记

# ============ 旧流水线触发层（可选保留） ============
MSTD_ENABLE_TRIGGER=0       # 1=启动 minutes.minute.generated_v1 长连接消费
MSTD_BACKFILL=0             # 1=启动时回扫最近妙记补建 job

# ============ E2E（真机回归，仅测试时置 1） ============
MSTD_E2E=0
MSTD_E2E_P2P_CHAT=          # 默认 test org 私聊 chat_id
# E2E 提速旋钮（生产勿动，默认即生产值）
MSTD_TICKER_INTERVAL_MS=    # 默认 60000
MSTD_HEARTBEAT_EVERY_TICKS= # 默认 5（=5 分钟一扫）
MSTD_HEARTBEAT_ACTIVE_START=# 默认 9（北京时间）
MSTD_HEARTBEAT_ACTIVE_END=  # 默认 21
MSTD_PI_IDLE_MS=            # 默认 600000（闲置 Pi 占并发位直到回收）
